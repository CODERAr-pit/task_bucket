# Database Configuration
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/your_db

# JWT Configuration
REFRESH_TOKEN_SECRET=your_very_long_refresh_secret_key_here
ACCESS_TOKEN_SECRET=your_very_long_access_secret_key_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Environment
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Email Configuration (Brevo/SendinBlue)
BREVO_API_KEY=your_brevo_api_key_here
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=TaskBucket
ADMIN_EMAIL=admin@yourdomain.com
FRONTEND_URL=http://localhost:5173

# Admin Panel Configuration
ADMIN_PANEL_SECRET=your_admin_panel_secret_key_here
