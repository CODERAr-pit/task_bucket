# ==============================
# DEPENDENCIES
# ==============================
# The heaviest folder; NPM will rebuild this on any machine using 'npm install'
node_modules/

# ==============================
# ENVIRONMENT VARIABLES & SECRETS
# ==============================
# CRITICAL: Never commit these! They contain your passwords and API keys.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==============================
# LOGS
# ==============================
# NPM and OS logs that clutter your repo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# ==============================
# BUILD OUTPUTS & CACHE
# ==============================
# Compiled code or cache files generated by bundlers (like Vite, Webpack, TS)
dist/
build/
.next/
out/
.cache/
.parcel-cache/

# ==============================
# TESTING & COVERAGE
# ==============================
coverage/
.nyc_output/

# ==============================
# OS & EDITOR FILES
# ==============================
# Annoying hidden files created by Macs and Code Editors (VS Code)
.DS_Store
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?