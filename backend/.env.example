
MONGODB_URI=
REFRESH_TOKEN_SECRET=edc_refresh_secret_key_very_long_and_secure_2024
ACCESS_TOKEN_SECRET=edc_access_secret_key_very_long_and_secure_2024

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173


# Resend Email Configuration (HTTP API, works on Render — SMTP does not)
RESEND_API_KEY=
FROM_EMAIL=TaskBucket <notifications@yourdomain.com>

# Admin emails (comma-separated)
ADMIN_EMAILS=

# Frontend URL
FRONTEND_URL=http://localhost:5173


# Rate Limiting Configuration
RATE_LIMITING_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
TASK_RATE_LIMIT_WINDOW_MS=60000
TASK_RATE_LIMIT_MAX_REQUESTS=30
ADMIN_RATE_LIMIT_WINDOW_MS=300000
ADMIN_RATE_LIMIT_MAX_REQUESTS=50
SENSITIVE_RATE_LIMIT_WINDOW_MS=3600000
SENSITIVE_RATE_LIMIT_MAX_REQUESTS=20
SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true
RATE_LIMIT_SKIP_FAILED_REQUESTS=false