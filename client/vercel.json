{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://task-bucket.onrender.com/:path*"
    },
    {
      "source": "/auth/google",
      "destination": "https://task-bucket.onrender.com/auth/google"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
